generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth. UUID ids preserve the identifiers exported from auth.users so
// every existing owner_id/user_id relationship remains valid after cutover.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  username      String?   @unique
  referredBy    String?   @map("referred_by")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?

  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Better Auth's database-backed limiter stores epoch milliseconds, which
// exceed PostgreSQL's 32-bit integer range. A unique key makes concurrent
// requests share the same counter.
model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

enum CurrencyCode {
  XOF
  XAF
  GHS
  NGN
  KES
  MAD
  USD

  @@map("currency_code")
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded

  @@map("order_status")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded

  @@map("payment_status")
}

enum PaymentProvider {
  flutterwave
  manual
  free
  pawapay
  stripe
  geniuspay

  @@map("payment_provider")
}

enum SubscriptionPlan {
  free
  starter
  pro

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  cancelled
  incomplete

  @@map("subscription_status")
}

enum BillingInterval {
  month
  year

  @@map("billing_interval")
}

enum SubscriptionProvider {
  stripe
  geniuspay

  @@map("subscription_provider")
}

enum PromoDiscountType {
  percent
  fixed

  @@map("promo_discount_type")
}

model Profile {
  id                  String   @id @db.Uuid
  username            String?  @unique
  fullName            String?  @map("full_name")
  avatarUrl           String?  @map("avatar_url")
  bio                  String?
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  user                 User     @relation(fields: [id], references: [id], onDelete: Cascade)
  shops                Shop[]
  subscriptions        CreatorSubscription[]
  subscriptionPayments SubscriptionPayment[]
  boostPurchases       BoostPurchase[]
  statusEvents         OrderStatusEvent[]

  @@map("profiles")
}

model Template {
  id           String   @id
  name         String
  description  String?
  previewImage String?  @map("preview_image")
  config       Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  isPremium    Boolean  @default(false) @map("is_premium")
  shops        Shop[]

  @@map("templates")
}

model Shop {
  id                    String     @id @default(uuid()) @db.Uuid
  ownerId               String     @map("owner_id") @db.Uuid
  name                  String
  slug                  String     @unique
  description           String?
  logoUrl               String?    @map("logo_url")
  bannerUrl             String?    @map("banner_url")
  templateId            String?    @map("template_id")
  isPublished           Boolean    @default(false) @map("is_published")
  themeColor            String     @default("#6366F1") @map("theme_color")
  accentColor           String     @default("#0F172A") @map("accent_color")
  fontFamily            String     @default("sans") @map("font_family")
  borderRadius          String     @default("lg") @map("border_radius")
  cardStyle             String     @default("bordered") @map("card_style")
  ctaShape              String     @default("rounded") @map("cta_shape")
  ctaStyle              String     @default("filled") @map("cta_style")
  bioTheme              String     @default("classic") @map("bio_theme")
  currency              CurrencyCode @default(XOF)
  contactEmail          String?    @map("contact_email")
  contactPhone          String?    @map("contact_phone")
  socialLinks           Json?      @map("social_links")
  tiktokPixelId         String?    @map("tiktok_pixel_id")
  metaPixelId           String?    @map("meta_pixel_id")
  whatsappNumber        String?    @map("whatsapp_number")
  checkoutMode          String     @default("whatsapp") @map("checkout_mode")
  intentions            String[]   @default([])
  featuredUntil         DateTime?  @map("featured_until")
  customDomain          String?    @unique @map("custom_domain")
  customDomainVerifiedAt DateTime? @map("custom_domain_verified_at")
  showBioLienBadge      Boolean    @default(true) @map("show_biolien_badge")
  shippingEnabled       Boolean    @default(false) @map("shipping_enabled")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")
  owner                 Profile    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template              Template?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  categories            Category[]
  products              Product[]
  orders                Order[]
  links                 ShopLink[]
  pageBlocks            PageBlock[]
  pageViews             ShopPageView[]
  promoCodes            PromoCode[]
  creatorSubscriptions  CreatorSubscription[]
  boostPurchases        BoostPurchase[]
  customers             Customer[]
  analyticsEvents       AnalyticsEvent[]
  shippingZones         ShippingZone[]
  payoutAccount         PayoutAccount?
  payouts               Payout[]
  ledgerEntries         TransactionLedger[]
  formSubmissions       FormSubmission[]
  bookings              Booking[]

  @@index([ownerId])
  @@index([isPublished])
  @@map("shops")
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  shopId   String    @map("shop_id") @db.Uuid
  name     String
  slug     String
  position Int       @default(0)
  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shopId, slug])
  @@index([shopId])
  @@map("categories")
}

model Product {
  id            String           @id @default(uuid()) @db.Uuid
  shopId        String           @map("shop_id") @db.Uuid
  name          String
  slug          String
  description   String?
  price         Decimal          @default(0) @db.Decimal(14, 2)
  comparePrice  Decimal?         @map("compare_price") @db.Decimal(14, 2)
  currency      CurrencyCode     @default(XOF)
  images        Json             @default("[]")
  categoryId    String?          @map("category_id") @db.Uuid
  isPublished   Boolean          @default(false) @map("is_published")
  isDigital     Boolean          @default(false) @map("is_digital")
  stockQuantity Int?             @map("stock_quantity")
  hasVariants   Boolean          @default(false) @map("has_variants")
  metadata      Json?
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  shop          Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants      ProductVariant[]
  orderItems    OrderItem[]
  downloads     DigitalDownload[]

  @@unique([shopId, slug])
  @@index([shopId, isPublished])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(uuid()) @db.Uuid
  productId     String      @map("product_id") @db.Uuid
  name          String
  options       Json        @default("[]")
  price         Decimal?    @db.Decimal(14, 2)
  comparePrice  Decimal?    @map("compare_price") @db.Decimal(14, 2)
  stockQuantity Int?        @map("stock_quantity")
  sku           String?
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id               String           @id @default(uuid()) @db.Uuid
  shopId           String           @map("shop_id") @db.Uuid
  customerId       String?          @map("customer_id") @db.Uuid
  buyerEmail       String           @map("buyer_email")
  buyerName        String           @map("buyer_name")
  buyerPhone       String?          @map("buyer_phone")
  status           OrderStatus      @default(pending)
  paymentStatus    PaymentStatus    @default(pending) @map("payment_status")
  paymentProvider  PaymentProvider? @map("payment_provider")
  paymentRef       String?          @map("payment_ref")
  totalAmount      Decimal          @map("total_amount") @db.Decimal(14, 2)
  shippingAmount   Decimal          @default(0) @map("shipping_amount") @db.Decimal(14, 2)
  currency         CurrencyCode
  items            Json             @default("[]")
  shippingAddress  Json?            @map("shipping_address")
  notes            String?
  promoCode        String?          @map("promo_code")
  discountAmount   Decimal          @default(0) @map("discount_amount") @db.Decimal(14, 2)
  trackingToken    String           @unique @default(uuid()) @map("tracking_token") @db.Uuid
  /// Date à laquelle le stock a réellement été prélevé (au règlement) ;
  /// null tant que la commande n'est pas payée, ou si rien n'est suivi.
  stockReservedAt  DateTime?        @map("stock_reserved_at")
  /// Articles dont le stock manquait au moment du paiement (vendus par
  /// deux acheteurs en même temps) : le vendeur doit trancher.
  stockShortfall   Json?            @map("stock_shortfall")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  shop             Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  statusEvents     OrderStatusEvent[]
  downloads        DigitalDownload[]
  ledgerEntries    TransactionLedger[]

  @@index([shopId, createdAt])
  @@index([buyerEmail])
  @@index([shopId, status])
  @@map("orders")
}

model OrderItem {
  id              String          @id @default(uuid()) @db.Uuid
  orderId         String          @map("order_id") @db.Uuid
  productId       String?         @map("product_id") @db.Uuid
  variantId       String?         @map("variant_id") @db.Uuid
  quantity        Int
  unitPrice       Decimal         @map("unit_price") @db.Decimal(14, 2)
  subtotal        Decimal         @db.Decimal(14, 2)
  productSnapshot Json            @map("product_snapshot")
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  downloads       DigitalDownload[]

  @@index([orderId])
  @@map("order_items")
}

model CreatorSubscription {
  id                   String               @id @default(uuid()) @db.Uuid
  userId               String               @unique @map("user_id") @db.Uuid
  shopId               String?              @map("shop_id") @db.Uuid
  plan                 SubscriptionPlan     @default(free)
  status               SubscriptionStatus   @default(active)
  provider             SubscriptionProvider @default(stripe)
  billingInterval      BillingInterval?     @map("billing_interval")
  stripeCustomerId     String?              @map("stripe_customer_id")
  stripeSubscriptionId String?              @unique @map("stripe_subscription_id")
  currentPeriodEnd     DateTime?             @map("current_period_end")
  cancelAtPeriodEnd    Boolean              @default(false) @map("cancel_at_period_end")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  user                 Profile              @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop                 Shop?                @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@map("creator_subscriptions")
}

model SubscriptionPayment {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  plan        SubscriptionPlan
  months      Int
  amount      Decimal              @db.Decimal(12, 2)
  currency    String               @default("XOF")
  provider    SubscriptionProvider @default(geniuspay)
  reference   String               @unique
  status      PaymentStatus        @default(pending)
  periodStart DateTime?            @map("period_start")
  periodEnd   DateTime?            @map("period_end")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  user        Profile              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("subscription_payments")
}

model BoostPurchase {
  id                    String               @id @default(uuid()) @db.Uuid
  shopId                String               @map("shop_id") @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  type                  String
  amount                Int
  currency              String               @default("XOF")
  status                String               @default("pending")
  provider              SubscriptionProvider @default(stripe)
  reference             String?              @unique
  stripeSessionId       String?              @unique @map("stripe_session_id")
  stripePaymentIntentId String?              @unique @map("stripe_payment_intent_id")
  activatedAt           DateTime?            @map("activated_at")
  expiresAt             DateTime?            @map("expires_at")
  metadata              Json?
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  shop                  Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user                  Profile              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([userId])
  @@map("boost_purchases")
}

model ShopLink {
  id           String   @id @default(uuid()) @db.Uuid
  shopId       String   @map("shop_id") @db.Uuid
  label        String
  url          String
  icon         String   @default("custom")
  thumbnailUrl String?  @map("thumbnail_url")
  clickCount   Int      @default(0) @map("click_count")
  position     Int      @default(0)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  events       AnalyticsEvent[]

  @@index([shopId, position])
  @@map("shop_links")
}

model PageBlock {
  id         String   @id @default(uuid()) @db.Uuid
  shopId     String   @map("shop_id") @db.Uuid
  type       String
  position   Int      @default(0)
  title      String?
  config     Json     @default("{}")
  style      Json     @default("{}")
  visible    Boolean  @default(true)
  clickCount Int      @default(0) @map("click_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  events     AnalyticsEvent[]
  submissions FormSubmission[]
  bookings   Booking[]

  @@index([shopId, position])
  @@map("page_blocks")
}

model ShopPageView {
  shopId String   @map("shop_id") @db.Uuid
  day    DateTime @db.Date
  views  Int      @default(0)
  shop   Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@id([shopId, day])
  @@map("shop_page_views")
}

model PromoCode {
  id             String            @id @default(uuid()) @db.Uuid
  shopId         String            @map("shop_id") @db.Uuid
  code           String
  discountType   PromoDiscountType @map("discount_type")
  discountValue  Decimal           @map("discount_value") @db.Decimal(14, 2)
  minOrderAmount Decimal?          @map("min_order_amount") @db.Decimal(14, 2)
  maxUses        Int?              @map("max_uses")
  usesCount      Int               @default(0) @map("uses_count")
  expiresAt      DateTime?         @map("expires_at")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  shop           Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, code])
  @@index([shopId])
  @@map("promo_codes")
}

// ---------------------------------------------------------------------------
// Features completed during the Neon migration.
// ---------------------------------------------------------------------------

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  shopId         String       @map("shop_id") @db.Uuid
  email          String
  name           String?
  phone          String?
  tags           String[]     @default([])
  notes          String?
  marketingOptIn Boolean      @default(false) @map("marketing_opt_in")
  firstOrderAt   DateTime?    @map("first_order_at")
  lastOrderAt    DateTime?    @map("last_order_at")
  orderCount     Int          @default(0) @map("order_count")
  totalSpent     Decimal      @default(0) @map("total_spent") @db.Decimal(14, 2)
  currency       CurrencyCode @default(XOF)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@unique([shopId, email])
  @@index([shopId, lastOrderAt])
  @@map("customers")
}

model OrderStatusEvent {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @map("order_id") @db.Uuid
  status        OrderStatus
  note          String?
  publicMessage String?     @map("public_message")
  createdBy     String?     @map("created_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor         Profile?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model AnalyticsEvent {
  id        String    @id @default(uuid()) @db.Uuid
  shopId    String    @map("shop_id") @db.Uuid
  blockId   String?   @map("block_id") @db.Uuid
  linkId    String?   @map("link_id") @db.Uuid
  type      String
  visitorId String?   @map("visitor_id")
  sessionId String?   @map("session_id")
  source    String?
  medium    String?
  campaign  String?
  referrer  String?
  path      String?
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  block     PageBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  link      ShopLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([shopId, type, createdAt])
  @@map("analytics_events")
}

model ShippingZone {
  id           String       @id @default(uuid()) @db.Uuid
  shopId       String       @map("shop_id") @db.Uuid
  name         String
  countries    String[]     @default([])
  rate         Decimal      @db.Decimal(14, 2)
  freeAbove    Decimal?     @map("free_above") @db.Decimal(14, 2)
  estimatedMin Int?         @map("estimated_min")
  estimatedMax Int?         @map("estimated_max")
  isActive     Boolean      @default(true) @map("is_active")
  currency     CurrencyCode @default(XOF)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("shipping_zones")
}

model DigitalDownload {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String    @map("order_id") @db.Uuid
  orderItemId      String?   @map("order_item_id") @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  token            String    @unique @default(uuid()) @db.Uuid
  fileKey          String    @map("file_key")
  fileName         String?   @map("file_name")
  downloadCount    Int       @default(0) @map("download_count")
  downloadLimit    Int       @default(5) @map("download_limit")
  expiresAt        DateTime? @map("expires_at")
  lastDownloadedAt DateTime? @map("last_downloaded_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem        OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("digital_downloads")
}

model TransactionLedger {
  id          String        @id @default(uuid()) @db.Uuid
  shopId      String        @map("shop_id") @db.Uuid
  orderId     String?       @map("order_id") @db.Uuid
  type        String
  amount      Decimal       @db.Decimal(14, 2)
  currency    CurrencyCode
  status      String        @default("posted")
  provider    String?
  reference   String?
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([orderId])
  @@map("transaction_ledger")
}

model PayoutAccount {
  id                String   @id @default(uuid()) @db.Uuid
  shopId            String   @unique @map("shop_id") @db.Uuid
  provider          String
  accountName       String   @map("account_name")
  accountIdentifier String   @map("account_identifier")
  country           String?
  isVerified        Boolean  @default(false) @map("is_verified")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

model Payout {
  id          String       @id @default(uuid()) @db.Uuid
  shopId      String       @map("shop_id") @db.Uuid
  amount      Decimal      @db.Decimal(14, 2)
  currency    CurrencyCode
  /// requested → processing → paid | failed (voir src/lib/payouts/config.ts)
  status      String       @default("requested")
  provider    String
  reference   String?      @unique
  /// Compte de reversement tel qu'il était au moment de la demande.
  destination Json?
  /// Note de l'équipe (référence du transfert, motif de refus…).
  note        String?
  periodStart DateTime?    @map("period_start")
  periodEnd   DateTime?    @map("period_end")
  paidAt      DateTime?    @map("paid_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([status, createdAt])
  @@map("payouts")
}

model FormSubmission {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  blockId     String?   @map("block_id") @db.Uuid
  email       String?
  name        String?
  answers     Json
  consent     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  block       PageBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@map("form_submissions")
}

model Booking {
  id            String    @id @default(uuid()) @db.Uuid
  shopId        String    @map("shop_id") @db.Uuid
  blockId       String?   @map("block_id") @db.Uuid
  customerName  String    @map("customer_name")
  customerEmail String    @map("customer_email")
  customerPhone String?   @map("customer_phone")
  startsAt      DateTime  @map("starts_at")
  endsAt        DateTime? @map("ends_at")
  status        String    @default("pending")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  block         PageBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@index([shopId, startsAt])
  @@map("bookings")
}
