# =============================================================================
# LinkBoutik — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# ---- App --------------------------------------------------------------------
# Public base URL used for Stripe success/cancel redirects, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mode de vente. Vide ou absente (le défaut) : la caisse Bio-Lien est masquée,
# toute commande part sur WhatsApp et le vendeur la marque payée lui-même.
# « 1 » : rallume le mode En ligne pour tout le monde (Mobile Money et carte
# côté acheteur, paiement à la livraison, commission, reversements à l'écran).
# Valeur NEXT_PUBLIC_ : figée dans les bundles au build, redéployer après
# l'avoir changée. Les abonnements vendeurs et les boosts ne la lisent jamais.
# Voir src/lib/payments/online-checkout.ts.
NEXT_PUBLIC_ONLINE_CHECKOUT=

# ---- Neon PostgreSQL (new primary database) ---------------------------------
# En local et en preview, viser la branche Neon « development » (schéma seul,
# sans données de production) : npx neonctl connection-string development
# Runtime URL: use the pooled Neon endpoint (`-pooler` host).
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
# Schema changes + migration: use the direct Neon endpoint.
DIRECT_URL=postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<database>?sslmode=require
DATABASE_POOL_MAX=10
# Garde-fou (src/lib/db/database-guard.ts) : hors Vercel Production, le serveur
# et le CLI Prisma refusent de démarrer si DATABASE_URL/DIRECT_URL visent
# l'endpoint Neon de la branche de production ; sur Vercel Production, ils
# refusent tout AUTRE endpoint (le build échoue, l'ancien déploiement reste).
# L'endpoint de production est connu du code ; ajouter ici d'autres
# identifiants ep-… si la production change de branche.
# Ne jamais faire `vercel env pull --environment=production` en local.
# Dérogation assumée, le temps d'une opération : ALLOW_PRODUCTION_DATABASE=1
PRODUCTION_DATABASE_HOST=

# ---- Mesure de l'acquisition ------------------------------------------------
# Les pixels de Bio-Lien lui-même (accueil, tarifs, inscription, connexion —
# jamais sur les boutiques des vendeurs, qui ont les leurs). Vides : rien
# n'est chargé. Événements envoyés : CompleteRegistration, Subscribe.
# Les UTM du premier contact (utm_source…, ou ref=) sont gardés 30 jours en
# cookie et écrits sur le compte à l'inscription (user.acquisition) : voir
# src/lib/acquisition.ts. Valeurs NEXT_PUBLIC_ : redéployer après changement.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Numéro WhatsApp du support (format international, ex. +2267012…). Posé,
# les liens « Écrire au support » (Tarifs, retour de paiement) ouvrent une
# conversation WhatsApp pré-remplie ; vide, ils retombent sur l'e-mail.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ---- Référencement ------------------------------------------------------------
# Balises de vérification : coller le « content » que Google Search Console
# (méthode « balise HTML ») ou TikTok demandent. Vides : rien n'est émis.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_TIKTOK_SITE_VERIFICATION=
# Profils officiels de Bio-Lien (TikTok, Instagram, Facebook, LinkedIn…),
# séparés par des virgules : déclarés aux moteurs comme la même entité.
NEXT_PUBLIC_BRAND_PROFILES=

# ---- Équipe Bio-Lien --------------------------------------------------------
# Adresses (séparées par des virgules) qui voient /dashboard/admin/* et
# reçoivent le rapport quotidien et les alertes critiques (/dashboard/admin/ops)
# — et, mode En ligne seulement, les demandes de reversement
# (/dashboard/admin/payouts).
ADMIN_EMAILS=
# Optionnel : webhook sortant (Slack, ntfy…) qui reçoit les alertes critiques
# en JSON ({ text, title, severity }) — utile quand c'est l'e-mail qui tombe.
OPS_ALERT_WEBHOOK_URL=

# ---- Better Auth ------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=<32-byte-random-secret>
# Optional Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Resend (transactional buyer/seller/auth emails) ------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=Bio-Lien <notifications@your-domain.example>

# ---- Cloudflare R2 (images + private digital products) ----------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=biolien-assets
# Public custom domain for storefront images. Digital files use signed URLs.
R2_PUBLIC_URL=https://cdn.your-domain.example

# ---- Stripe (required: seller subscriptions by card, in CAD) ----------------
# Requis même drapeau éteint : l'abonnement vendeur par carte passe par Stripe.
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for /api/webhooks/stripe. L'endpoint doit recevoir
# checkout.session.completed/expired, customer.subscription.updated/deleted,
# invoice.payment_failed, charge.refunded, charge.dispute.created/closed.
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional launch coupon applied to subscription checkouts.
STRIPE_COUPON_ID=
# Subscription Price IDs — create one Stripe Price per (plan, interval),
# in CAD (the Stripe account's home currency). Buyer-side product checkouts
# (mode En ligne, derrière NEXT_PUBLIC_ONLINE_CHECKOUT=1) use XOF — Stripe
# handles the conversion at charge time.
# Leave blank to have the API synthesise prices inline via price_data
# (useful in dev, not recommended in prod).
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_YEARLY_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
# Legacy single-Price config — kept so any older Stripe Price still maps
# to the 'pro' tier in the webhook.
STRIPE_PRO_PRICE_ID=

# ---- GeniusPay (Mobile Money — required: prepaid seller subscriptions) -------
# Requis même drapeau éteint : l'abonnement vendeur prépayé en XOF passe par
# Genius Pay. Le Mobile Money côté acheteur (paiement d'une commande) est le
# mode En ligne, derrière NEXT_PUBLIC_ONLINE_CHECKOUT=1.
GENIUSPAY_BASE_URL=https://api.geniuspay.example
GENIUSPAY_API_KEY=<geniuspay-api-key>
GENIUSPAY_API_SECRET=<geniuspay-api-secret>
# Signing secret for /api/webhooks/geniuspay (abonnements ; commandes en mode En ligne)
GENIUSPAY_WEBHOOK_SECRET=<geniuspay-webhook-secret>

# ---- Anthropic (required for the free AI tools under /api/outils/*) ----------
# Read automatically by the Anthropic SDK (`new Anthropic()`).
ANTHROPIC_API_KEY=sk-ant-...

# ---- Upstash Redis (rate limiting + global AI budget cap) -------------------
# Required in production for the distributed per-IP limits and the global daily
# ceiling on /api/outils/*. Without these, only an in-memory per-instance
# limiter applies (no budget cap). Provision via the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>

# ---- WhatsApp Cloud API (optional — seller order notifications) -------------
# Mode En ligne, derrière le drapeau : ne sert qu'aux commandes payées par la
# caisse Bio-Lien. Drapeau éteint, la commande EST le message WhatsApp que
# l'acheteur envoie au vendeur — rien à configurer ici.
# When unset, seller notifications are skipped (orders still work).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template used for seller order alerts (see README "Notifications WhatsApp")
WHATSAPP_ORDER_TEMPLATE=nouvelle_commande
WHATSAPP_TEMPLATE_LANG=fr
