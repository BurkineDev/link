# =============================================================================
# LinkBoutik — environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# ---- App --------------------------------------------------------------------
# Public base URL used for Stripe success/cancel redirects, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Neon PostgreSQL (new primary database) ---------------------------------
# Runtime URL: use the pooled Neon endpoint (`-pooler` host).
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
# Schema changes + migration: use the direct Neon endpoint.
DIRECT_URL=postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<database>?sslmode=require
DATABASE_POOL_MAX=10

# ---- Better Auth ------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=<32-byte-random-secret>
# Optional Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Resend (transactional buyer/seller/auth emails) ------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=Bio-Lien <notifications@your-domain.example>

# ---- Cloudflare R2 (images + private digital products) ----------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=biolien-assets
# Public custom domain for storefront images. Digital files use signed URLs.
R2_PUBLIC_URL=https://cdn.your-domain.example

# ---- Temporary Supabase compatibility during cutover ------------------------
# Keep these variables only until every deployment is reading Neon. They let
# the current production app keep running while the migration is verified.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Direct PostgreSQL source used only by `npm run db:migrate:data`.
SUPABASE_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ---- Stripe (required for card payments) ------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional launch coupon applied to subscription checkouts.
STRIPE_COUPON_ID=
# Subscription Price IDs — create one Stripe Price per (plan, interval),
# in CAD (the Stripe account's home currency). Buyer-side product checkouts
# still use XOF — Stripe handles the conversion at charge time.
# Leave blank to have the API synthesise prices inline via price_data
# (useful in dev, not recommended in prod).
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_YEARLY_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
# Legacy single-Price config — kept so any older Stripe Price still maps
# to the 'pro' tier in the webhook.
STRIPE_PRO_PRICE_ID=

# ---- GeniusPay (Mobile Money — required for mobile money payments) ----------
GENIUSPAY_BASE_URL=https://api.geniuspay.example
GENIUSPAY_API_KEY=<geniuspay-api-key>
GENIUSPAY_API_SECRET=<geniuspay-api-secret>
# Signing secret for /api/webhooks/geniuspay
GENIUSPAY_WEBHOOK_SECRET=<geniuspay-webhook-secret>

# ---- Anthropic (required for the free AI tools under /api/outils/*) ----------
# Read automatically by the Anthropic SDK (`new Anthropic()`).
ANTHROPIC_API_KEY=sk-ant-...

# ---- Upstash Redis (rate limiting + global AI budget cap) -------------------
# Required in production for the distributed per-IP limits and the global daily
# ceiling on /api/outils/*. Without these, only an in-memory per-instance
# limiter applies (no budget cap). Provision via the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>

# ---- WhatsApp Cloud API (optional — seller order notifications) -------------
# When unset, seller notifications are skipped (orders still work).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template used for seller order alerts (see README "Notifications WhatsApp")
WHATSAPP_ORDER_TEMPLATE=nouvelle_commande
WHATSAPP_TEMPLATE_LANG=fr
